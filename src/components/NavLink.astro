---
const { href, text } = Astro.props;
---

<li>
    <a
        href={href}
        class="p-2 text-xl font-coco bg-white/30 rounded-xl hover:bg-white/50 active:bg-white/50"
    >
        <span class="text-[13px] font-bold">{text.split("")[0]}</span>{
            text.split("").slice(1).join("")
        }
    </a>
</li>
