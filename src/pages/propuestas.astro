---
import type { Metadata } from "@/types";
import Layout from "@/layouts/layout.astro";

const metadata: Metadata = {
	title: "CielitoLindo - Propuestas",
	description:
		"Conocé nuestras propuestas y modalidades de consultas astrológicas.",
	canonical: "https://espaciocielitolindo.com.ar/propuestas",
	slug: "/propuestas",
	og: {
		title: "CielitoLindo - Propuestas",
		description:
			"Conocé nuestras propuestas y modalidades de consultas astrológicas.",
		image: "og_propuestas.png",
	},
	twitter: {
		title: "CielitoLindo - Propuestas",
		description:
			"Conocé nuestras propuestas y modalidades de consultas astrológicas.",
		image: "og_propuestas.png",
	},
};
---

<Layout metadata={metadata}>
	<main
		class="flex flex-col items-center font-inter gap-12 pb-12 animate-fadein"
	>
		<section
			class="w-full lg:max-w-[960px] xl:max-w-[1200px] 2xl:max-w-[1400px] px-4 md:px-8 space-y-12"
		>
			<!-- INTRO & QUÉ ENCONTRÁS -->
			<article class="backdrop-blur-sm rounded-xl p-8 sm:p-12 space-y-10">
				<h1 class="text-4xl font-coco text-center text-neutral-900">
					<span class="text-[24px] font-bold">P</span>ropuestas
				</h1>

				<div
					class="text-lg sm:text-xl leading-relaxed text-neutral-800 text-pretty max-w-3xl mx-auto space-y-6"
				>
					<p
						class="first-letter:text-6xl first-letter:font-coco first-letter:text-arena first-letter:mr-1 first-letter:leading-[0.8] mt-1 font-medium text-center inline-block"
					>
						Trabajamos en equipo: juntas enriquecemos y ampliamos la
						mirada.
					</p>
					<p class="text-center">
						Te invitamos a un proceso de acompañamiento a partir de
						la apertura de tu carta natal. La propuesta es compartir
						una serie de encuentros que permitan sensibilizar y
						comprender tus cualidades, talentos y mecanismos para
						habilitar y expandir tu propia mirada.
					</p>
				</div>

				<div class="pt-8 border-t border-arena/30">
					<h3
						class="text-2xl font-coco text-center text-neutral-900 mb-8"
					>
						¿Qué podes encontrar en una consulta astrológica?
					</h3>
					<div
						class="columns-1 md:columns-2 gap-10 text-lg leading-relaxed text-neutral-800 text-pretty"
					>
						<p class="mb-4 break-inside-avoid">
							Contar con información sobre tu configuración te
							permite agudizar el registro y actualizar la mirada
							de tu realidad.
						</p>
						<p class="mb-4 break-inside-avoid">
							Te permite contactar con desafíos, talentos y
							potencialidades.
						</p>
						<p class="mb-4 break-inside-avoid">
							Es un espacio de intercambio en el que dialogamos,
							hacemos preguntas, y ablandamos nuestras
							resistencias para nombrar lo que está en sombra.
						</p>
						<p class="mb-4 break-inside-avoid">
							En ocasiones, la consulta deviene proceso donde,
							encuentro tras encuentro, vamos conectando con los
							personajes arquetípicos que forman parte de nuestra
							constelación para acercarnos a la totalidad que
							somos.
						</p>
						<p class="mb-4 break-inside-avoid">
							Puede complementar y acompañar otros procesos y
							herramientas terapéuticas (Psicoanálisis, Gestalt,
							Counseling, Constelaciones Familiares, Tarot, Flores
							de Bach, etc.). Todo abona al camino de integración.
						</p>
						<p
							class="break-inside-avoid font-medium text-neutral-900">
							Te esperamos de manera presencial o virtual para
							hacer la lectura de carta o revolución solar.
						</p>
					</div>
				</div>
			</article>

			<!-- CARTA NATAL -->
			<article
				class="bg-white/20 border-3 border-arena backdrop-blur-sm rounded-xl p-8 sm:p-12 shadow-md flex flex-col md:flex-row gap-8 lg:gap-12 items-center"
			>
				<div
					class="w-full max-w-[240px] md:max-w-none mx-auto md:mx-0 md:w-1/3"
				>
					<div
						class="aspect-square bg-neutral-200 rounded-3xl flex items-center justify-center overflow-hidden border-4 border-white/50 shadow-inner"
					>
						<span class="text-neutral-500 font-medium"
							>Carta Natal</span
						>
					</div>
				</div>
				<div class="w-full md:w-2/3 space-y-6">
					<h3
						class="text-3xl font-coco text-neutral-900 border-b border-arena/50 pb-2 inline-block"
					>
						Carta Natal
					</h3>
					<div
						class="text-lg leading-relaxed text-neutral-800 text-pretty space-y-4"
					>
						<p>
							La carta natal es el dibujo del cielo en el momento
							exacto en que nacemos. Es una herramienta que
							muestra el diseño de la semilla que somos y su
							potencial de despliegue. Muestra la posición de los
							planetas y sus relaciones, aportando una valiosa
							información que describe nuestro viaje sin definir
							cuál es.
						</p>
						<p>
							En la carta natal conviven diferentes sistemas de
							símbolos. Este lenguaje nos permite investigar las
							cualidades energéticas a través de los signos, las
							funciones psíquicas personales mediante los
							planetas, y las casas en tanto ámbitos de
							experiencia en los que se despliega el viaje de la
							conciencia.
						</p>
						<p>
							En consulta abordamos la potencialidad de la carta
							natal: invitamos a identificar los aspectos donde se
							ha construido identidad y a reconocer aquellos que
							han quedado en sombra con la intención de integrar
							la totalidad que somos.
						</p>
						<p>
							Sos bienvenida/o si tenés ganas de empezar un
							proceso de autoconocimiento, si querés indagar en
							patrones de repetición, si hay temáticas o vínculos
							que generan preocupación, malestar o confusión, o si
							querés conocer los aspectos más relevantes de tu
							carta natal.
						</p>
					</div>

					<div
						class="bg-white/60 p-6 rounded-lg border border-arena/30 space-y-2 mt-4 text-neutral-800"
					>
						<h4 class="font-coco text-xl text-neutral-900 mb-2">
							Info útil
						</h4>
						<ul class="list-disc list-inside space-y-1">
							<li>Virtual o Presencial.</li>
							<li>Uno o dos encuentros de una hora y media.</li>
							<li>
								Necesitamos contar con tus datos de nacimiento:
								día, hora y lugar.
							</li>
						</ul>
					</div>
				</div>
			</article>

			<!-- REVOLUCIÓN SOLAR -->
			<article
				class="bg-white/20 border-3 border-arena backdrop-blur-sm rounded-xl p-8 sm:p-12 shadow-md flex flex-col md:flex-row-reverse gap-8 lg:gap-12 items-center"
			>
				<div
					class="w-full max-w-[240px] md:max-w-none mx-auto md:mx-0 md:w-1/3"
				>
					<div
						class="aspect-square bg-neutral-200 rounded-3xl flex items-center justify-center overflow-hidden border-4 border-white/50 shadow-inner"
					>
						<span class="text-neutral-500 font-medium"
							>Revolución Solar</span
						>
					</div>
				</div>
				<div class="w-full md:w-2/3 space-y-6 md:text-right">
					<h3
						class="text-3xl font-coco text-neutral-900 border-b border-arena/50 pb-2 inline-block"
					>
						Revolución Solar, Tránsitos y Progresiones
					</h3>
					<div
						class="text-lg leading-relaxed text-neutral-800 text-pretty space-y-4 md:text-left"
					>
						<p>
							La carta de la revolución solar nos muestra una
							imagen del cielo en el momento en el que el sol
							vuelve al punto exacto en el que se encontraba
							cuando nacimos. Marca por ende el inicio de un nuevo
							ciclo de 365 días. Dado que la revolución solar se
							trata de un momento en el despliegue de nuestra
							carta natal siempre las investigamos y abordamos en
							conjunto.
						</p>
						<p>
							El sistema solar es un sistema viviente coherente e
							inteligente que se encuentra en constante
							movimiento. Esta dinámica tiene un impacto en
							nuestro sistema psíquico, por lo cual el estudio de
							los tránsitos planetarios nos permite conocer cómo
							el cielo va activando determinadas zonas y planetas
							de nuestra carta natal.
						</p>
						<p>
							Para obtener información complementaria en relación
							a lo más subjetivo de nuestro estado actual también
							incorporamos otras técnicas como las Progresiones
							Secundarias y el Ciclo Sol Luna.
						</p>
						<p>
							En suma, estas herramientas nos permiten contactar
							con el estado psíquico del año en curso: qué
							energías están disponibles, qué desafíos y
							aprendizajes podrían presentarse, con qué dones
							contamos para hacer el recorrido. En síntesis, el
							trabajo personal al que estamos invitadas e
							invitados.
						</p>
						<p
							class="font-medium text-neutral-900 text-center md:text-right italic"
						>
							Sos bienvenida/o a descubrir la propuesta que el
							cielo tiene para vos.
						</p>
					</div>

					<div
						class="bg-white/60 p-6 rounded-lg border border-arena/30 space-y-2 mt-4 text-neutral-800 text-left"
					>
						<h4 class="font-coco text-xl text-neutral-900 mb-2">
							Info útil
						</h4>
						<ul class="list-disc list-inside space-y-1">
							<li>Virtual o Presencial.</li>
							<li>Dos encuentros de una hora y media.</li>
							<li>
								Necesitamos contar con tus datos de nacimiento:
								día, hora y lugar.
							</li>
							<li>
								No es requisito haber hecho la carta natal
								previamente.
							</li>
							<li>
								Se puede hacer cerca de la fecha del cumpleaños,
								pero no es excluyente. El momento oportuno es
								cuando aparezca la inquietud de consultar con
								los astros.
							</li>
						</ul>
					</div>
				</div>
			</article>

			<!-- REGALÁ EXPERIENCIA & OTRAS PROPUESTAS -->
			<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
				<!-- REGALO -->
				<article
					class="bg-[#e4dccb] border-3 border-arena backdrop-blur-sm rounded-xl p-8 shadow-md flex flex-col justify-center items-center text-center"
				>
					<h3 class="text-3xl font-coco text-neutral-900 mb-6">
						Regalá experiencia
					</h3>
					<div
						class="text-lg leading-relaxed text-neutral-800 space-y-4"
					>
						<p class="italic font-medium">
							¿Buscas un regalo que trascienda lo material y
							llegue al corazón?
						</p>
						<p>
							En Cielitolindo ofrecemos la oportunidad de regalar
							experiencias que transforman y conectan. Podés
							obsequiar la lectura de la carta natal o la
							revolución solar a través de nuestros vouchers.
						</p>
						<p>
							La persona homenajeada solo necesita contactarse con
							nosotras, agendar y disfrutar de su regalo. Podés
							hacerlo desde y hacia cualquier parte del mundo.
						</p>
						<p class="text-xl font-coco text-neutral-900 mt-4">
							¡Regalá un momento especialmente pensado para la
							persona que querés!
						</p>
					</div>
				</article>

				<!-- OTRAS -->
				<article
					class="bg-white/80 backdrop-blur-sm rounded-xl p-8 shadow-md flex flex-col"
				>
					<h3
						class="text-3xl font-coco text-neutral-900 mb-6 border-b border-arena/50 pb-2 inline-block self-start"
					>
						Otras propuestas
					</h3>
					<ul
						class="text-lg leading-relaxed text-neutral-800 space-y-6 flex-1"
					>
						<li class="flex flex-col">
							<span class="font-semibold text-neutral-900 text-xl"
								>Talleres</span
							>
						</li>
						<li class="flex flex-col">
							<span class="font-semibold text-neutral-900 text-xl"
								>Consultoría y Proceso</span
							>
						</li>
						<li class="flex flex-col">
							<span class="font-semibold text-neutral-900 text-xl"
								>Orientación Vocacional</span
							>
							<span class="text-base mt-1"
								>Espacio de acompañamiento para indagar y
								profundizar tus dones y talentos al servicio del
								mundo profesional.</span
							>
						</li>
						<li class="flex flex-col">
							<span class="font-semibold text-neutral-900 text-xl"
								>Consultoría Psicológica</span
							>
						</li>
						<li class="flex flex-col">
							<span class="font-semibold text-neutral-900 text-xl"
								>Consulta individual de terapia sistémica</span
							>
						</li>
					</ul>
				</article>
			</div>
		</section>
	</main>
</Layout>
