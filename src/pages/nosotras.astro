---
import type { Metadata } from "@/types";
import Layout from "@/layouts/layout.astro";
import PlanetLoader from "@/components/PlanetLoader.astro";
import Divider from "@/components/Divider.astro";

const metadata: Metadata = {
	title: "CielitoLindo - Nosotras",
	description:
		"Conocé a las creadoras de CielitoLindo, un espacio de astrología.",
	canonical: "https://espaciocielitolindo.com.ar/",
	slug: "/",
	og: {
		title: "CielitoLindo - Nosotras",
		description:
			"Conocé a las creadoras de CielitoLindo, un espacio de astrología.",
		image: "og_nosotras.png",
	},
	twitter: {
		title: "CielitoLindo - Nosotras",
		description:
			"Conocé a las creadoras de CielitoLindo, un espacio de astrología.",
		image: "og_nosotras.png",
	},
};
---


<Layout metadata={metadata}>
	<main class="flex flex-col items-center font-inter gap-12 pb-12 animate-fadein">
		<section id="hero-section" class="w-full relative h-[85vh] lg:h-[100vh] min-h-[400px] overflow-hidden flex flex-col justify-end">
			<img src="/images/nosotras.jpg" class="absolute inset-0 w-full h-full object-cover object-[center_30%]">
			
			<div class="absolute inset-0 bg-gradient-to-t from-neutral-900/70 via-neutral-900/20 to-transparent"></div>
			
			<div class="relative z-10 flex flex-col items-center justify-center pb-8 md:pb-12">
				<div class="relative flex items-center justify-center w-full min-h-[160px] md:min-h-[200px]">
					<div class="absolute w-[90px] h-[90px] md:w-[120px] md:h-[120px] border border-white/30 rounded-full animate-[spin_10s_linear_infinite]">
						<div class="absolute top-0 left-1/2 -translate-x-1/2 -translate-y-1/2 w-3 h-3 bg-amber-100 rounded-full shadow-[0_0_15px_4px_rgba(254,243,199,0.5)]"></div>
					</div>
					<div class="z-10 text-center flex flex-col items-center">
						<p class="text-white font-medium text-sm md:text-base tracking-[0.2em] font-inter px-6 drop-shadow-md leading-relaxed">
							EXPLORÁ NUESTRO UNIVERSO
						</p>
					</div>
				</div>
				<button id="scroll-btn" class="mt-4 md:mt-2 cursor-pointer hover:scale-110 transition-transform focus:outline-none" aria-label="Explorar contenido">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-white/80 drop-shadow-md" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
						<path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
					</svg>
				</button>
			</div>
		</section>

		<section class="w-full lg:max-w-[960px] xl:max-w-[1200px] 2xl:max-w-[1400px] px-4 md:px-8 space-y-12">
			<article class="bg-white/80 backdrop-blur-sm rounded-xl p-8 sm:p-12 shadow-md">
				<h1 class="text-4xl font-coco text-center mb-8 text-neutral-900">
					<span class="text-[24px] font-bold">N</span>osotras
				</h1>
				<div class="text-lg sm:text-xl leading-relaxed text-neutral-800 space-y-6 text-pretty max-w-3xl mx-auto">
					<p class="first-letter:text-6xl first-letter:font-coco first-letter:text-arena first-letter:mr-2 first-letter:float-left first-letter:leading-[0.8] mt-1">
						Estudiamos en la facultad de ciencias sociales en la <strong class="font-medium text-neutral-900">UBA</strong>, somos <strong class="font-medium text-neutral-900">Licenciadas en Relaciones del Trabajo</strong>. Aunque nos graduamos el mismo año, nos conocimos tiempo después trabajando en el ámbito de las políticas públicas.
					</p>
					<p>
						Juntas dimos nuestros primeros pasos en el estudio y la vivencia de la astrología. Más adelante fuimos aprendiendo otras disciplinas y herramientas con el propósito de acompañar a personas en sus procesos de despliegue y conexión con lo esencial.
					</p>
					<p>
						Compartimos un amor ancestral por Italia, los gatos y el tango. Trabajamos y vivimos en Villa Pueyrredón, escenario de nuestro máximo desafío: acompañar amorosa y conscientemente el crecimiento de <strong class="font-medium text-neutral-900">Cielitolindo</strong> y el de nuestras pequeñas hijas, <strong class="font-medium text-neutral-900">Camelia y Vera</strong>.
					</p>
				</div>
			</article>

			<!-- ASTROLOGÍA -->
			<article class="bg-white/20 border-3 border-arena backdrop-blur-sm rounded-xl p-8 sm:p-12 shadow-md">
				<h2 class="text-4xl font-coco text-center mb-8 text-neutral-900">
					<span class="text-[24px] font-bold">A</span>strología
				</h2>
				
				<div class="columns-1 md:columns-2 gap-10 text-lg sm:text-xl leading-relaxed text-neutral-800 text-pretty">
					<p class="first-letter:text-6xl first-letter:font-coco first-letter:text-arena first-letter:mr-2 first-letter:float-left first-letter:leading-[0.8] mt-1 mb-6 md:mb-0 break-inside-avoid">
						Nos formamos como astrólogas con Jose Río en <span class="font-semibold text-neutral-900">Astrología Abierta</span> y Claudia Plegaria en <span class="font-semibold text-neutral-900">Escuela Solsticio</span>, ambos egresados de <span class="font-semibold text-neutral-900">CASA XI</span>. Nos especializamos con Carolina Goldsman en Astrología y Gestalt, sumamos los aportes de la astrología tradicional de la mano de Gi Juliano y nos tomamos distintos módulos con Alejandro Lodi, en <span class="font-semibold text-neutral-900">Aurea</span>.
					</p>
					<p class="mb-6 md:mb-0 break-inside-avoid">
						También nos formamos en Consultoría Psicológica (<span class="font-semibold text-neutral-900">Instituto Superior Intercambio</span>), Medicina Ayurveda (<span class="font-semibold text-neutral-900">USHA</span>) y Constelaciones Familiares (María Cecilia Doria en <span class="font-semibold text-neutral-900">Casa Bambú</span>).
					</p>
                    <p class="mb-6 md:mb-0 break-inside-avoid">
						Lo cosechado a lo largo de estos caminos de aprendizaje conforma nuestro singular enfoque de trabajo.
                    </p>
				</div>

				<div class="mt-10 pt-8 border-t border-arena/30 flex flex-col items-center gap-6">
					<p class="text-lg sm:text-xl text-center text-neutral-800 max-w-3xl">
						Agradecemos a nuestras maestras y maestros por sus generosos y valiosos aportes. Su acompañamiento ha sido sumamente transformador y habilitante.
					</p>
				</div>
			</article>
		</section>
	</main>
</Layout>

<script>
	const btn = document.getElementById('scroll-btn');
	const hero = document.getElementById('hero-section');
	
	if (btn && hero) {
		btn.addEventListener('click', () => {
			window.scrollTo({
				top: hero.offsetHeight,
				behavior: 'smooth'
			});
		});
	}
</script>