---
import type { Metadata } from "@/types";
import Layout from "@/layouts/layout.astro";
import PlanetLoader from "@/components/PlanetLoader.astro";
import Divider from "@/components/Divider.astro";

const metadata: Metadata = {
	title: "CielitoLindo - Web en desarrollo",
	description:
		"Próximamente! La página web de CielitoLindo, un taller emprendedor de consultas astrológicas.",
	canonical: "https://espaciocielitolindo.com.ar/",
	slug: "/",
	og: {
		title: "CielitoLindo - Web en desarrollo",
		description:
			"Próximamente! La página web de CielitoLindo, un taller emprendedor de consultas astrológicas.",
		image: "og_landing.png",
	},
	twitter: {
		title: "CielitoLindo - Web en desarrollo",
		description:
			"Próximamente! La página web de CielitoLindo, un taller emprendedor de consultas astrológicas.",
		image: "og_landing.png",
	},
};
---

<Layout metadata={metadata}>
	<main
		class="flex flex-col items-center font-inter gap-12 pb-12 animate-fadein"
	>
		<section
			class="w-full lg:max-w-[960px] xl:max-w-[1200px] 2xl:max-w-[1400px] h-screen pt-56 md:pt-32 flex flex-col items-center relative px-4 md:px-8"
		>
			<div
				class="absolute -z-10 inset-0 m-auto bg-cielo w-full h-full sm:h-[80%] mt-[60px] sm:mt-[100px] rounded-xl shadow-xl"
			>
			</div>
			<h1
				class="text-4xl sm:text-5xl font-coco text-center mb-6 text-neutral-900"
			>
				<span class="text-[32px] font-bold">C</span>ielitolindo
			</h1>
			<div
				class="bg-white/80 backdrop-blur-sm rounded-xl p-6 sm:p-8 max-w-[95%] sm:max-w-[85%] md:max-w-[75%] shadow-md"
			>
				<p>
					<p
						class="text-lg sm:text-xl text-center leading-relaxed text-neutral-800"
					>
						Bienvenidas y bienvenidos a <strong>Cielitolindo</strong
						>, un <strong>espacio</strong> para la <strong
							>exploración personal</strong
						> y el <strong>crecimiento consciente</strong>.
					</p>
					<p
						class="text-lg sm:text-xl text-center leading-relaxed text-neutral-800"
					>
						Nuestro propósito es <strong
							>acompañar procesos de desarrollo</strong
						> utilizando la <strong>astrología</strong> como principal
						lenguaje de autoconocimiento.
					</p>
					<p
						class="text-lg sm:text-xl text-center leading-relaxed text-neutral-800"
					>
						A lo largo de estos años hemos creado un <strong
							>enfoque integral</strong
						> que ponemos al servicio a través de las distintas propuestas
						que ofrecemos.
					</p><p
						class="text-lg sm:text-xl text-center leading-relaxed text-neutral-800"
					>
						¡Te invitamos a conocerlas!
					</p>
				</p>
			</div>
		</section>

		<section
			class="flex flex-col lg:flex-row lg:justify-between w-full lg:max-w-[960px] xl:max-w-[1200px] 2xl:max-w-[1400px] gap-8"
		>
			<article
				class="w-full flex flex-col items-center justify-center relative"
			>
				<div
					class="bg-white/20 border-3 border-arena w-full backdrop-blur-sm rounded-xl p-6 sm:p-8 h-full lg:shadow-md flex items-center"
				>
					<div
						class="text-lg sm:text-xl text-center leading-relaxed text-neutral-800 space-y-6"
					>
						<p>
							En Cielitolindo nos gusta pensar la Astrología como
							un lenguaje simbólico que aclara y amplía la visión
							de la realidad que experimentamos. Nos permite
							profundizar y resignificar la idea que tenemos de
							nosotros mismos, nuestros vínculos y planes
						</p>
						<p>
							En lugar de confirmarnos y llenarnos de etiquetas,
							la astrología nos propone ablandar nuestras
							resistencias para integrar la totalidad que somos.
							Nos ayuda a sensibilizar nuestra percepción y
							permite captar la sutileza de nuestro propio orden.
						</p>
						<p>
							La astrología nos ayuda a comprender la riqueza que
							se aloja en la ciclicidad de los procesos. Solo
							podemos contactar con la claridad del amanecer luego
							de haber atravesado el misterio de la noche.
							Descubrir el vínculo entre la persona que somos y lo
							que se presenta desde afuera es Astrología.
						</p>
					</div>
				</div>
			</article>
		</section>

		<section>
			<h2 class="text-4xl font-coco text-center mb-6 text-neutral-900">
				<span class="text-[24px] font-bold">N</span>osotras
			</h2>
			<div
				class="flex flex-col lg:flex-row lg:justify-between w-full lg:max-w-[960px] xl:max-w-[1200px] 2xl:max-w-[1400px] gap-8"
			>
				<article
					class="w-full hidden lg:flex lg:w-1/2 h-[500px] md:h-[600px] p-16 items-center justify-center bg-white/80 backdrop-blur-sm rounded-xl shadow-md"
				>
					<!-- Placeholder para la foto de las chicas -->
					<div
						class="w-full h-full bg-neutral-200 rounded-lg flex items-center justify-center text-neutral-600"
					>
						[Foto de Lu y Iani]
					</div>
				</article>
				<article
					class="w-full lg:w-1/2 h-[500px] lg:h-[600px] flex flex-col items-center justify-center relative"
				>
					<div
						class="w-full h-full lg:hidden bg-neutral-200 rounded-t-lg flex items-center justify-center text-neutral-600"
					>
						[Foto de Lu y Iani]
					</div>
					<div
						class="bg-white/80 w-full backdrop-blur-sm lg:rounded-xl p-6 sm:p-8 h-full lg:shadow-md flex flex-col justify-center items-center"
					>
						<div
							class="text-lg block sm:text-xl/9 text-center leading-relaxed text-neutral-800"
						>
							<p>Somos Lu y Iani. Virgo y Piscis, la unión de la
							razón y la magia, del orden y del caos creador, la
							parte y el todo. Sembramos nuestra semilla
							astrológica en el 2017 y desde entonces este
							lenguaje simbólico y profundo se ha convertido en
							una forma de mirar y habitar la vida.</p>
						</div>
						<a href="/nosotras" class="text-lg font-bold mt-3 underline">Conocenos más!</a>
					</div>
				</article>
			</div>
		</section>

		<section class="mt-8">
			<h2 class="text-4xl font-coco text-center mb-6 text-neutral-900">
				<span class="text-[24px] font-bold">P</span>ropuestas
			</h2>
			<div
				class="flex flex-col lg:flex-row-reverse lg:justify-between w-full lg:max-w-[960px] xl:max-w-[1200px] 2xl:max-w-[1400px] gap-8"
			>
				<article
					class="w-full hidden lg:flex lg:w-1/2 h-[500px] md:h-[600px] p-16 items-center justify-center bg-white/80 backdrop-blur-sm rounded-xl shadow-md"
				>
					<div
						class="w-full h-full bg-neutral-200 rounded-lg flex items-center justify-center text-neutral-600"
					>
						[Imagen ilustrativa Propuestas]
					</div>
				</article>
				<article
					class="w-full lg:w-1/2 h-[500px] lg:h-[600px] flex flex-col items-center justify-center relative"
				>
					<div
						class="w-full h-full lg:hidden bg-neutral-200 rounded-t-lg flex items-center justify-center text-neutral-600"
					>
						[Imagen ilustrativa Propuestas]
					</div>
					<div
						class="bg-white/80 w-full backdrop-blur-sm lg:rounded-xl p-6 sm:p-8 h-full lg:shadow-md flex flex-col justify-center items-center"
					>
						<div
							class="text-lg block sm:text-xl/9 text-center leading-relaxed text-neutral-800"
						>
							<p>Ofrecemos distintos espacios y modalidades de 
							consulta astrológica. Desde el clásico encuentro para 
							la lectura de Carta Natal y Revolución Solar, hasta 
							talleres y procesos grupales de profundización. Todo 
							pensado para acompañar tu despliegue esencial.</p>
						</div>
						<a href="/propuestas" class="text-lg font-bold mt-3 underline">Conocé más!</a>
					</div>
				</article>
			</div>
		</section>
	</main>
</Layout>
